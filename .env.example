# Environment variables the application reads. Nothing loads this file
# automatically: set them in your shell, or under `environment:` in
# docker-compose.yml. No API keys or tokens belong here; model keys are typed
# per request in the UI and sign-in tokens stay in API memory.

# UI process: the API origin. Compose sets http://api:8000.
API_BASE_URL=http://localhost:8000

# API process: port in the "Sign in with ChatGPT" loopback address
# http://127.0.0.1:{port}/callback. Change it only when the API is published
# on another host port.
OPENAI_CALLBACK_PORT=8000
